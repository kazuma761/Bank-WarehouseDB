# Copy to .env (never commit .env). Every source URL is read from one of these variables.
BANKQL_FINANCIAL_URL=sqlite:///data/fixture/financial.sqlite
BANKQL_DEMO_URL=duckdb:///data/bank_demo.duckdb
# scripts/setup_postgres.sh generates random passwords and writes these two lines into .env:
BANKQL_PG_URL=postgresql+psycopg://bankql_ro:CHANGE_ME@localhost:5432/bankql_fixture
BANKQL_PG_ADMIN_URL=postgresql+psycopg://bankql_admin:CHANGE_ME@localhost:5432/bankql_fixture
# Comma-separated API keys for the REST / OpenAI-compatible API (compared in constant time).
BANKQL_API_KEYS=change-me
# Local llama.cpp servers (OpenAI-compatible). CPU cloud: one at a time on :8080. GPU: Gemma :8080, Arctic :8081.
BANKQL_ROUTER_URL=http://localhost:8080/v1
BANKQL_SQL_URL=http://localhost:8081/v1
BANKQL_REDIS_URL=redis://localhost:6379/0
